# Environment configuration template for AI Smart Tutor

PROJECT_NAME="AI Smart Tutor — Data Exploration and Visualization Laboratory"
VERSION="1.0.0"
DEBUG=false

# Security: Generate a 32+ character random string in production
SECRET_KEY="generate-a-strong-random-secret-key-for-production-min-32-chars"
SESSION_EXPIRE_MINUTES=1440
COOKIE_SECURE=false

# Database: PostgreSQL for production/Docker; SQLite can be used for local dev/testing
# Example PostgreSQL: postgresql://postgres:postgres@localhost:5432/ai_smart_tutor
# Example Docker Compose: postgresql://postgres:postgres@postgres:5432/ai_smart_tutor
DATABASE_URL="sqlite:///./storage/ai_smart_tutor.db"

# CORS Allowlist (comma separated)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

# Rate Limiting
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_AI_PER_MINUTE=30
RATE_LIMIT_UPLOAD_PER_MINUTE=15

# LLM Provider Configuration ("mock", "gemini", "openai", "ollama")
LLM_PROVIDER="mock"
LLM_API_KEY=""
LLM_MODEL="gemini-1.5-flash"
LLM_TIMEOUT_SECONDS=25.0
